    <!-- M4（R7/R8）：设置页的网络切换策略说明（只读） -->
    <string name="settings_note_order_title">选择顺序</string>
    <string name="settings_note_order_detail">网络能力 → 选路规则（传输类型 / Wi-Fi 名称 / 本机网段）→ 没有规则命中时对多个地址并行竞速（TCP 1.5 秒）→ 协议握手才算真正确定。</string>
    <string name="settings_note_cache_title">结果缓存</string>
    <string name="settings_note_cache_detail">连通性结果与竞速结果都缓存 60 秒；系统网络回调（切 Wi-Fi / 切蜂窝 / 换网段）一来立刻失效并重测。</string>
    <string name="settings_note_credential_title">凭据</string>
    <string name="settings_note_credential_detail">协议密码在保存时立即用 Android Keystore（AES-GCM）加密，库里只存密文，界面不回显明文。</string>
    <string name="settings_note_protocol_title">协议现状</string>
    <string name="settings_note_protocol_detail">本地目录、WebDAV、SFTP、FTP 四种协议都能浏览与播放：在连接页建好并「设为当前连接」即可。连通性测试会做真正的协议握手（本地查目录、WebDAV 发 PROPFIND、SFTP 走 SSH 认证、FTP 走登录 + PASV）。</string>

    <!-- SFTP 主机密钥（R2 / plan 4.9）：TOFU 落库后的展示与复原出口 -->
    <string name="trusted_host_keys_title">已信任的 SFTP 主机密钥</string>
    <string name="trusted_host_keys_subtitle">首次连接时按 TOFU 记住；之后指纹一变就会拒绝连接（防中间人）。服务器确实换过密钥时，在这里忘掉旧记录即可重新信任。</string>
    <string name="trusted_host_keys_empty">还没有记录（连过一次 SFTP 就会有）。</string>
    <string name="trusted_host_keys_forget">忘掉</string>
    <string name="trusted_host_keys_forget_all">全部忘掉</string>

