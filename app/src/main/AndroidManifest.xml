<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 联网与网络状态（R2/R7） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 后台播放与批量字幕任务（R18/R19） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 澎湃 OS 保活引导（R18）：申请「省电策略无限制」需要用系统弹窗（设置页里也提供跳转入口） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      应用内更新（R20）：下载完 APK 后要交给**系统安装器**。
      Android 不允许静默安装，这一步必然有系统确认页；首次还会要求用户允许本应用「安装未知应用」。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 本地媒体（R1/R12）：媒体库入口可选，全盘访问在设置页引导 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" xmlns:tools="http://schemas.android.com/tools" />

    <!--
      画中画（R13）：能力可选（没有该特性的设备照样能装能播，只是没有小窗）。
      真机要求：Activity 必须 supportsPictureInPicture，且把 PIP 会触发的配置变化自己处理掉
      （否则进出小窗会重建 Activity，播放页 ViewModel 一重建，画面与位置就都断了）。
    -->
    <uses-feature
        android:name="android.software.picture_in_picture"
        android:required="false" />

    <application
        android:name=".MediaGateApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.MediaGate">

        <!--
          画中画（R13）：supportsPictureInPicture + 自己处理 PIP 相关的配置变化
          （screenSize/screenLayout/smallestScreenSize/orientation 是 PIP 进出时系统会发的），
          其余键盘/导航/字体/语言等一并接管，避免播放中被重建。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.MediaGate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          音频后台播放（R18）：MediaSessionService + 前台服务（mediaPlayback 类型）。
          exported=true + 标准 action 是 Media3 的约定：系统的媒体控制（通知栏/锁屏/蓝牙/耳机键）
          通过它绑定会话；:app 只负责声明，服务本体在 :media:playback。
        -->
        <service
            android:name="io.github.gua123.mediagate.media.playback.AudioPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          视频后台播放（M8-A / R18 视频侧）：MediaSessionService + 前台服务（mediaPlayback 类型）。
          只提供"会话与通知"——播放本体仍是播放页的内核（见 :media:playback 的 VideoPlaybackService），
          因此 exported=false：系统媒体控制走 MediaSession，不需要系统来 bind 这个服务。
        -->
        <service
            android:name="io.github.gua123.mediagate.media.playback.VideoPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false" />

        <!--
          应用内更新（R20）：把下载到 filesDir/updates 的 APK 通过 content:// 交给系统安装器
          （Android 7 起禁止 file:// 直接外传）。authorities 用 applicationId 前缀，debug 包也不会冲突。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          批量字幕任务中心（M7-B / R19）：前台服务 + 通知进度（可暂停/取消）。
          foregroundServiceType=mediaProcessing 对应 manifest 顶部的
          FOREGROUND_SERVICE_MEDIA_PROCESSING 权限；只由本应用自己启动，故 exported=false。
        -->
        <service
            android:name="io.github.gua123.mediagate.app.AsrForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing"
            android:stopWithTask="false" />
    </application>
</manifest>
